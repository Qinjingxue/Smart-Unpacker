{
  "cli": {
    "language": "zh"
  },
  "thresholds": {
    "archive_score_threshold": 6,
    "maybe_archive_threshold": 3
  },
  "recursive_extract": "*",
  "nested_extraction_policy": {
    "enabled": true,
    "byte_ratio_exponent": 1,
    "project_ratio_exponent": 1,
    "authorization_bias": 0,
    "minimum_authorization_score": 0.85,
    "minimum_archive_byte_ratio": 0.1,
    "hard_maximum_other_projects": 1000
  },
  "post_extract": {
    "archive_cleanup_mode": "r",
    "flatten_single_directory": true
  },
  "filesystem": {
    "directory_scan_mode": "*",
    "scan_filters_enabled": true,
    "scan_filters": [
      {
        "name": "directory_prune",
        "enabled": true,
        "prune_dir_globs": [
          ".git", ".vscode", "__pycache__", "node_modules", "site-packages", ".venv", "venv", "env", ".cache",
          "repositories"
        ],
        "path_globs": [".git/**", ".vscode/**", "$RECYCLE.BIN/**"]
      },
      {
        "name": "whitelist",
        "enabled": false,
        "path_globs": ["archives/**", "downloads/**"],
        "prune_dir_globs": ["archives", "downloads"],
        "allowed_files": ["sample.zip"],
        "allowed_extensions": [".zip", ".7z", ".rar"]
      },
      {
        "name": "blacklist",
        "enabled": true,
        "blocked_files": ["Thumbs.db", "desktop.ini"],
        "blocked_extensions": [
          ".dll", ".save", ".py", ".pyc", ".json", ".xml", ".cfg", ".ini", ".sys", ".db", ".msi", ".cur",
          ".ani", ".ttf", ".woff", ".ico", ".pak", ".obb", ".unitypackage", ".jar", ".apk", ".ipa", ".epub",
          ".odt", ".ods", ".odp", ".docx", ".xlsx", ".pptx", ".whl", ".xpi", ".war", ".ear", ".aab", ".ckpt",
          ".pt", ".pth", ".safetensors", ".bin", ".dat", ".docm", ".xlsm", ".pptm"
        ]
      },
      {
        "name": "size_range",
        "enabled": true,
        "range": "r >= 1 MB"
      },
      {
        "name": "mtime_range",
        "enabled": false,
        "date": "20270101 00:00 > d >= 20240101 00:00"
      }
    ]
  },
  "performance": {
    "precise_resource_min_size_mb": 256,
    "persistent_server_idle_seconds": 15,
    "worker": {
      "profile": "auto",
      "throughput_window_size": 8,
      "throughput_regression_ratio": 0.95,
      "idle_decay_seconds": 30.0,
      "max_task_seconds": 1800,
      "watchdog_no_progress_timeout_seconds": 180,
      "watchdog_interval_ms": 500,
      "thread_capacity": 0,
      "stage_thread_capacity": 0,
      "max_inflight_files": 0,
      "max_pending_stage_jobs": 4096,
      "adaptive_enabled": true,
      "initial_active_jobs": 0,
      "sample_interval_ms": 500,
      "max_queue_jobs": 4096,
      "priority_aging_quantum": 32,
      "backpressure_retries": 120,
      "writer_threads": 4,
      "memory_budget_bytes": 0,
      "job_buffer_budget_bytes": 33554432,
      "profile_calibration_window_size": 4,
      "profile_regression_ratio": 0.8,
      "profile_improvement_ratio": 1.2,
      "profile_calibration_max_delta": 1,
      "profile_calibration_min_parallel": 2,
      "profile_calibration_cache_enabled": true,
      "cpu_scale_up_threshold_percent": 65,
      "cpu_scale_down_threshold_percent": 88,
      "memory_scale_down_available_mb": 1024,
      "memory_scale_up_available_mb": 2048
    },
    "resource_guard": {
      "enabled": false,
      "max_file_count": 0,
      "max_total_unpacked_size": 0,
      "max_largest_item_size": 0,
      "max_compression_ratio": 0
    }
  },
  "watch": {
    "cold_start_seconds": 1.0,
    "quiet_min_seconds": 1.25,
    "quiet_max_seconds": 180.0,
    "boundary_confirmation_seconds": 0.5,
    "initial_scan": true,
    "max_folders": 16,
    "observer_stop_timeout_seconds": 5.0,
    "runtime_cache_cleanup_enabled": true,
    "runtime_cache_cleanup_idle_seconds": 10.0,
    "password_retry_debounce_seconds": 0.5,
    "password_retry_include_subtree": true,
    "clipboard_monitor_enabled": true,
    "clipboard_builtin_max_entries": 30,
    "enabled": false,
    "roots": [],
    "out_dir": ".",
    "tray_enabled": true,
    "state_dir": "",
    "reload_poll_seconds": 1.0
  },
  "passwords": {
    "clipboard_passwords_enabled": true,
    "directory_passwords_enabled": true,
    "directory_passwords_max_file_bytes": 1048576,
    "directory_passwords_max_password_length": 512
  },
  "extraction": {
    "write_progress_manifest": false,
    "content_requirement": "complete"
  },
  "embedded_scan": {
    "enabled": true
  },
  "input_planning": {
    "enabled": true,
    "cache_size": 512
  },
  "repair_inspection": {
    "cache_size": 512
  },
  "analysis": {
    "max_concurrent_reads": 1,
    "shared_cache_mb": 64,
    "max_read_mb_per_archive": 256,
    "prepass": {
      "enabled": true,
      "head_bytes": 1048576,
      "tail_bytes": 1048576
    },
    "fuzzy": {
      "enabled": true,
      "modules": [
        {
          "name": "binary_profile",
          "enabled": true,
          "window_bytes": 65536,
          "max_windows": 8,
          "max_sample_bytes": 1048576,
          "entropy_high_threshold": 6.8,
          "entropy_low_threshold": 3.5,
          "entropy_jump_threshold": 1.25,
          "ngram_top_k": 8,
          "max_ngram_sample_bytes": 262144
        }
      ]
    },
    "thresholds": {
      "extractable_confidence": 0.85,
      "repair_confidence": 0.35
    },
    "modules": [
      {
        "name": "zip",
        "enabled": true,
        "max_cd_entries_to_walk": 64
      },
      {
        "name": "rar",
        "enabled": true,
        "max_blocks_to_walk": 4096
      },
      {
        "name": "seven_zip",
        "enabled": true,
        "max_next_header_check_bytes": 1048576
      },
      {
        "name": "tar",
        "enabled": true,
        "max_entries_to_walk": 64
      },
      {
        "name": "gzip",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "bzip2",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "xz",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "zstd",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "tar_gz",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "tar_bz2",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "tar_xz",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "tar_zst",
        "enabled": true,
        "max_probe_bytes": 4194304
      }
    ]
  },
  "verification": {
    "enabled": true,
    "max_retries": 2,
    "cleanup_failed_output": true,
    "complete_accept_threshold": 0.999,
    "partial_accept_threshold": 0.2,
    "recovery_min_improvement": 0.0,
    "retry_on_verification_failure": true,
    "methods": [
      {
        "name": "extraction_exit_signal",
        "enabled": true
      },
      {
        "name": "output_presence",
        "enabled": true
      },
      {
        "name": "expected_name_presence",
        "enabled": true,
        "max_expected_names": 50,
        "required_match_ratio": 0.8,
        "minor_missing_penalty": 10,
        "missing_penalty": 35,
        "all_missing_penalty": 60
      },
      {
        "name": "manifest_size_match",
        "enabled": true,
        "max_expected_names": 2000,
        "file_count_abs_tolerance": 2,
        "file_count_ratio_tolerance": 0.05,
        "size_abs_tolerance_bytes": 1048576,
        "size_ratio_tolerance": 0.02
      },
      {
        "name": "archive_test_crc",
        "enabled": true,
        "max_items": 200000,
        "max_reported_items": 20
      },
      {
        "name": "sample_readability",
        "enabled": true,
        "max_samples": 64,
        "read_bytes": 4096,
        "max_reported_items": 20
      }
    ]
  },
  "repair": {
    "enabled": true,
    "workspace": ".sunpack_repair",
    "keep_candidates": false,
    "max_attempts_per_task": 100,
    "max_repair_rounds_per_task": 100,
    "max_repair_seconds_per_task": 200,
    "comparison_no_improvement_patience_rounds": 20,
    "max_repair_generated_files_per_task": 16,
    "max_repair_generated_mb_per_task": 2048,
    "stagnation_patience_rounds": 3,
    "min_recovery_improvement": 0.01,
    "runtime_cache": {
      "enabled": true,
      "max_entries": 512
    },
    "safety": {
      "allow_unsafe": false,
      "allow_lossy": false
    },
    "module_limits": {
      "max_candidates_per_module": 3,
      "max_entries": 20000,
      "max_seconds_per_module": 30,
      "max_input_size_mb": 512,
      "max_output_size_mb": 2048,
      "max_entry_uncompressed_mb": 512,
      "verify_candidates": true,
      "max_stream_trim_probe_attempts": 32,
      "max_stream_trim_decode_mb": 64,
      "max_gzip_footer_fix_decode_mb": 32,
      "max_next_header_scan_bytes": 1048576
